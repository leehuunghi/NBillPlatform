# VietQR — đăng ký lấy ở https://vietqr.io, dùng để tạo QR trả nợ.
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# Bắt buộc khi deploy lên Vercel (filesystem chỉ đọc-ghi tạm thời nên data
# phải commit thẳng vào GitHub qua Contents API). Không cần khi chạy local
# (npm run dev:all) — lúc đó ghi thẳng vào src/data.json.
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_REPO_BRANCH=main
# GITHUB_DATA_PATH=src/data.json
